# Lanes used by .github/workflows/release-builds.yml (not needed for local builds).
#
# Environment: NOTARY_API_KEY_ID, NOTARY_API_ISSUER_ID, NOTARY_API_KEY_P8 (the .p8 text),
# APPLE_TEAM_ID, and for Firebase FIREBASE_PROJECT_NUMBER, FIREBASE_IOS_APP_ID,
# FIREBASE_SERVICE_ACCOUNT_JSON. The App Store Connect API key needs access to Certificates,
# Identifiers & Profiles (Admin) to register the bundle id and devices and to make profiles.

default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("NOTARY_API_KEY_ID"),
      issuer_id: ENV.fetch("NOTARY_API_ISSUER_ID"),
      key_content: ENV.fetch("NOTARY_API_KEY_P8"),
      is_key_content_base64: false,
      duration: 1200
    )
  end

  # Firebase App Distribution testers' UDIDs -> devices registered with Apple. Devices already
  # registered are left as they are, so this is safe to run every time.
  lane :sync_devices do
    file = File.expand_path("../build-ios/tester_udids.txt", __dir__)
    FileUtils.mkdir_p(File.dirname(file))
    firebase_app_distribution_get_udids(
      project_number: ENV.fetch("FIREBASE_PROJECT_NUMBER").to_i,
      service_credentials_json_data: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_JSON"),
      output_file: file
    )
    if File.exist?(file)
      UI.message(File.read(file))
      register_devices(devices_file: file, api_key: asc_key)
    end
  end

  # A fresh ad-hoc profile for bundle_id holding every iPhone / iPad / Vision Pro registered for
  # the team, written to `output` (the app isn't an Xcode project, so xcodebuild can't make it).
  # Registers the bundle id first if the team doesn't have it yet.
  lane :adhoc_profile do |options|
    bundle_id = options.fetch(:bundle_id)
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_key)
    unless Spaceship::ConnectAPI::BundleId.find(bundle_id)
      UI.message("Registering the bundle id #{bundle_id}")
      Spaceship::ConnectAPI::BundleId.create(name: options[:name] || bundle_id, identifier: bundle_id,
                                             platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS)
    end
    output = File.expand_path(options.fetch(:output))
    get_provisioning_profile(
      api_key: asc_key,
      app_identifier: bundle_id,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      adhoc: true,
      force: true,   # remade every run, so it holds the devices registered since the last one
      include_all_certificates: false,
      output_path: File.dirname(output),
      filename: File.basename(output)
    )
  end

  # Upload an .ipa to Firebase App Distribution and invite the given groups (comma-separated).
  lane :distribute do |options|
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_IOS_APP_ID"),
      service_credentials_json_data: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_JSON"),
      ipa_path: options.fetch(:ipa),
      groups: options[:groups].to_s.empty? ? nil : options[:groups],
      release_notes: options[:notes]
    )
  end
end
